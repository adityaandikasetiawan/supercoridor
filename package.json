{
  "name": "supercorridor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,vite -c blue,green \"node --watch server/index.mjs\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.mjs",
    "server": "node server/index.mjs",
    "db:create": "node server/create-db.mjs",
    "db:seed": "node server/seed.mjs",
    "db:clear": "node server/clear-db.mjs",
    "db:setup": "node server/create-db.mjs && node server/seed.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-aspect-ratio": "^1.0.3",
